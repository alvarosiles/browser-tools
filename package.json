{
  "name": "browser-tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "cross-env GITHUB_PAGES=true vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "agent": "npm start --prefix local-agent",
    "agent:install": "npm install --prefix local-agent",
    "web": "concurrently -n agent,web -c yellow,cyan \"npm run agent\" \"npm run dev\"",
    "predeploy": "npm run build:pages",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0"
  }
}
